{
    "$schema": "node_modules/wrangler/config-schema.json",
    // Rust port of the Python Worker: deploys to decision-sandbox-rs.<subdomain>.workers.dev.
    "name": "decision-sandbox-rs",
    // JS shim generated by worker-build; it loads the compiled .wasm.
    "main": "build/index.js",
    "compatibility_date": "2026-10-03",
    "build": {
        "command": "cargo install -q \"worker-build@^0.8\" && worker-build --release"
    },
    // Same limits as the Python Worker, in namespaces of its own so the Workers don't share counters.
    "ratelimits": [
        {
            "name": "IP_RATE_LIMITER",
            "namespace_id": "3001",
            "simple": { "limit": 60, "period": 60 }
        },
        {
            "name": "KEY_RATE_LIMITER",
            "namespace_id": "3002",
            "simple": { "limit": 300, "period": 60 }
        }
    ],
    "observability": {
        "enabled": true
    }
}

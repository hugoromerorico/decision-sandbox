{
    "$schema": "node_modules/wrangler/config-schema.json",
    // Separate Worker from the Python one: deploys to decision-sandbox-rs.<subdomain>.workers.dev.
    "name": "decision-sandbox-rs",
    // JS shim generated by worker-build; it loads the compiled .wasm.
    "main": "build/index.js",
    "compatibility_date": "2026-10-03",
    "build": {
        "command": "cargo install -q \"worker-build@^0.8\" && worker-build --release"
    },
    "observability": {
        "enabled": true
    }
}

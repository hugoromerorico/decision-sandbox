{
    "$schema": "node_modules/wrangler/config-schema.json",
    // TypeScript port of the Python Worker: deploys to decision-sandbox-ts.<subdomain>.workers.dev.
    "name": "decision-sandbox-ts",
    // Wrangler bundles TypeScript with esbuild; no build step needed.
    "main": "src/index.ts",
    "compatibility_date": "2026-10-03",
    // The OpenAPI spec and docs pages exported from the Python app (task shared), served verbatim.
    "rules": [
        { "type": "Text", "globs": ["**/*.html", "**/openapi.json"], "fallthrough": false }
    ],
    // Same limits as the Python Worker, in namespaces of its own so the Workers don't share counters.
    "ratelimits": [
        {
            "name": "IP_RATE_LIMITER",
            "namespace_id": "2001",
            "simple": { "limit": 60, "period": 60 }
        },
        {
            "name": "KEY_RATE_LIMITER",
            "namespace_id": "2002",
            "simple": { "limit": 300, "period": 60 }
        }
    ],
    "observability": {
        "enabled": true
    }
}

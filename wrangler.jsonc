{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "decision-sandbox",
    "main": "src/entry.py",
    "compatibility_date": "2026-10-03",
    "compatibility_flags": [
        "python_workers"
    ],
    // Keep in sync with src/sandbox/limits.py. Period must be 10 or 60 seconds.
    "ratelimits": [
        {
            "name": "IP_RATE_LIMITER",
            "namespace_id": "1001",
            "simple": { "limit": 60, "period": 60 }
        },
        {
            "name": "KEY_RATE_LIMITER",
            "namespace_id": "1002",
            "simple": { "limit": 300, "period": 60 }
        }
    ],
    "observability": {
        "enabled": true
    }
}
